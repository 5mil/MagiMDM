<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/school" android:text="School" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <Button android:id="@+id/free" android:text="Free" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <Button android:id="@+id/exam" android:text="Exam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <Button android:id="@+id/lock" android:text="Lock" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    </LinearLayout>
    <Button android:id="@+id/refresh" android:text="Refresh" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/list" android:paddingTop="16dp" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="match_parent" />
</LinearLayout>
