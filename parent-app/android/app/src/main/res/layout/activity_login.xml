<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <EditText android:id="@+id/url" android:hint="https://mdm.home" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" />
    <EditText android:id="@+id/user" android:hint="parent username" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/pass" android:hint="password" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btn" android:text="Sign in" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
</LinearLayout>
