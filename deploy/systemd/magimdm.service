[Unit]
Description=MagiMDM house desk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fivemil
Group=fivemil
WorkingDirectory=/home/fivemil/magimdm
ExecStart=/home/fivemil/magimdm/zig-out/bin/zig-mdm
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
# LAN only is enforced by ufw, not this unit

[Install]
WantedBy=multi-user.target
